# Secrets manifest — the map from a sealed vault file to where its plaintext lands
# on the t630. seal.sh / unseal.sh read this file. Format (whitespace-separated):
#
#   <sealed file in vault/>   <plaintext deploy path on the box>   <mode>
#
# The plaintext NEVER lives in the repo — only the sealed *.env.sops does, and only
# the runtime path (git-ignored / outside the repo) holds cleartext. `mode` is the
# chmod applied to the deployed plaintext. Add a row per secret file; the listed
# paths are the ones the service compose files / systemd units already expect.

# sealed (vault/)        deployed plaintext path            mode
pihole.env.sops          /home/USER/pihole/.env             600
llm-router.env.sops      /home/USER/llm-router/.env         600
ttyd.env.sops            /etc/a777ance/ttyd.env             600
jury.env.sops            /home/USER/localDNS/04-user-services/ai-orchestration/jury/.env         600
jury-claude.env.sops     /home/USER/localDNS/04-user-services/ai-orchestration/jury-claude/.env  600
