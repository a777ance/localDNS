# Copy to /etc/a777ance/ttyd.env  (chmod 600, root-owned) — NEVER commit the real file.
# Sourced by ttyd-thinclient.service and ttyd-laptop.service via EnvironmentFile.

# The ONLY gate to a shell. Treat like a root password. Format: user:password.
# Rotate this out of the sops+age vault, not by hand.
TTYD_CREDENTIAL=CHANGE_ME:CHANGE_ME

# Where the laptop terminal SSHes to, using the t630 as the jump host.
# MUST be a STABLE address — the laptop's WireGuard IP or a DHCP-reserved LAN IP,
# never a floating lease. Example: myuser@10.8.0.3
LAPTOP_SSH=CHANGE_ME@10.8.0.CHANGE_ME
