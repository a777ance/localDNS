# The Jury (Claude backend) — environment. Copy to `.env` (git-ignored) and fill in.
# Never commit the real key. See repo CLAUDE.md "No secrets in git".

ANTHROPIC_API_KEY=CHANGE_ME

# Optional: override the model default baked into jury_claude.py's flags.
# JURY_MODEL=claude-opus-5
#
# A bare Anthropic() client also picks up an `ant auth login` profile, so the
# key is optional if you authenticate that way instead.
