# Copy to ~/llm-router/.env (git-ignored) and fill in — NEVER commit the real file.
# In production these are unsealed from the sops+age vault. See CLAUDE.md
# "No secrets in git".

# Gates the LiteLLM front door (and is what Open WebUI presents to it). Also
# fail-closed in docker-compose.yml via ${LITELLM_MASTER_KEY:?...}.
LITELLM_MASTER_KEY=CHANGE_ME

# Cloud tier (Anthropic). Leave UNSET to keep every request local — the cloud
# fallbacks then fail closed instead of egressing. Set only when you want overflow.
ANTHROPIC_API_KEY=CHANGE_ME

# Rented GPU tier (RunPod — see runpod-idle-stop.sh and REMEDIATION-BOARD.md Track 6
# "Exception (2026-08-16)"). Needed only by the idle-stop cron job, not by LiteLLM
# itself. RUNPOD_API_KEY: RunPod dashboard -> Settings -> API Keys. RUNPOD_POD_ID:
# the pod's ID from the RunPod console URL. TAILSCALE_GPU_HOST must match the
# api_base host pinned in config.yaml's cloud-gpu-reason entry.
RUNPOD_API_KEY=CHANGE_ME
RUNPOD_POD_ID=CHANGE_ME
TAILSCALE_GPU_HOST=CHANGE_ME
