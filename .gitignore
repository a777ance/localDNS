# Secrets and local-only files
.env
*.env
secrets/

# Sealed-vault working area: filled plaintext secrets live here transiently before
# seal.sh encrypts them into vault/*.env.sops. NEVER commit cleartext. The sealed
# vault/*.env.sops files ARE committed (age-encrypted — safe).
vault/cleartext/

# LLM router runtime data (Open WebUI state — created on the box, not in the repo)
04-user-services/ai-orchestration/open-webui-data/

# Momentum loop arm/state (per-session, local — never committed)
.claude/.momentum-on
.claude/.momentum-state

# Editor scratch
*~
*.swp
.vscode/
.idea/

# OS metadata
.DS_Store
Thumbs.db

# Python bytecode
__pycache__/
*.pyc
