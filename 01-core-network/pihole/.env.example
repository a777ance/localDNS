# Copy to ~/pihole/.env (git-ignored) and fill in — NEVER commit the real file.
# In production this is unsealed from the sops+age vault, not hand-edited.
# See repo CLAUDE.md "No secrets in git".

# Pi-hole v6 admin / API password. Consumed by docker-compose.yml as
# FTLCONF_webserver_api_password via ${PIHOLE_WEBPASSWORD:?...} (fail-closed:
# `docker compose up` errors if this is unset).
PIHOLE_WEBPASSWORD=CHANGE_ME
